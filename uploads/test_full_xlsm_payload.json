      "module_name": "Module1",
      "code": "Sub CalculateAllTotals()\n  Dim ws As Worksheet\n  Set ws = ThisWorkbook.Sheets(\"MainData\")\n  ws.Range(\"D2\").Formula = \"=B2*C2*(1-DiscountRate)\"\n  ws.Range(\"D3\").Formula = \"=B3*C3*(1-DiscountRate)\"\n  ws.Range(\"D4\").Formula = \"=B4*C4*(1-DiscountRate)\"\nEnd Sub"
